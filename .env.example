# ── Database ────────────────────────────────────────────────
# SQLite path is relative to the repo root. Swap for PostgreSQL in production
# (the data layer is isolated in src/lib/db so the driver can be replaced).
DATABASE_FILE=data/femzyk.db

# ── Auth / sessions ─────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string

# ── Payments (never expose secret keys to the frontend) ────
# Provider: mock | flutterwave | paystack
PAYMENT_PROVIDER=mock
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Email (transactional provider) ──────────────────────────
EMAIL_API_KEY=
EMAIL_FROM="FEMZYK MARKET <hello@femzyk.example>"

# ── Storage (private digital file storage) ──────────────────
STORAGE_ROOT=data/files

# ── Analytics (optional external id) ────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
