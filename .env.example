# FEMZYK MARKET environment template.
# For local development, PAYMENT_PROVIDER=mock enables the internal test gateway.
# In production, select Flutterwave or Paystack explicitly and provide server keys.

# Database and private file storage must live on persistent storage when self-hosting.
DATABASE_FILE=data/femzyk.db
STORAGE_ROOT=data/files

# Public canonical origin (required for production payment callbacks and SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial admin is created only when no administrator exists.
# Production requires a valid email and a unique password of at least 20 characters.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Payment secrets are server-side only. Never use test keys in production.
PAYMENT_PROVIDER=mock
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional display defaults; prefer setting verified contact data in Admin → Settings.
SUPPORT_EMAIL=
BUSINESS_ADDRESS=

# NOTE: transactional and marketing email delivery is not integrated yet.
# Email events are stored in the admin outbox and are NOT sent.
